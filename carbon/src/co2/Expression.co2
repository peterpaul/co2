include co2/CompileObject
include co2/Type

void expression_generate_actual_argument (Expression arg, va_list *app) {
	FILE *fp = va_arg (*app, FILE *);
	Bool *is_first_arg = va_arg (*app, Bool *);

	if (!*is_first_arg) {
		fprintf (fp, ", ");
	} else {
		*is_first_arg = false;
	}
	arg.generate (fp);
}

// carbon's own type_check() already validates that `arg` is usable where
// `target_type` is expected (subtype, interface implementation, void* on
// either side) -- but unlike higher-level OOP languages, C has no implicit
// struct-pointer subtyping, so GCC/Clang still warn/error on the raw
// pointer-type mismatch unless an explicit cast bridges the two distinct
// struct tags. Only emit one when both sides are concrete ObjectTypes with
// different declarations; anything already void*-shaped on either side
// converts silently in C and needs no cast.
void expression_generate_casted (FILE *fp, Expression arg, Type target_type) {
	if (target_type && arg.type && target_type is_of ObjectType && arg.type is_of ObjectType) {
		ObjectType target_object_type = (ObjectType) target_type;
		ObjectType arg_object_type = (ObjectType) arg.type;
		if (target_object_type.decl && arg_object_type.decl && target_object_type.decl != arg_object_type.decl) {
			fprintf (fp, "(");
			target_type.generate (fp);
			fprintf (fp, ") ");
		}
	} else if (target_type && arg.type && target_type is_of FunctionType && arg.type is_of FunctionType) {
		// Callback arguments to map()/map_args()-style higher-order functions
		// routinely narrow their first parameter (e.g. RefObject -> VariableDeclaration)
		// relative to the generic callback signature the callee declares -- type_check()
		// already accepts this (the caller only ever invokes fun() with instances of the
		// narrower type), but C requires the two distinct function pointer types to match
		// exactly, so always bridge with an explicit cast. A cast to an identical type is
		// a harmless no-op, so no need to first check whether the signatures differ.
		FunctionType function_target_type = (FunctionType) target_type;
		fprintf (fp, "(");
		function_target_type.generate_cast (fp);
		fprintf (fp, ") ");
	}
	arg.generate (fp);
}

// Same comma-separated-argument-list generation expression_generate_actual_argument
// does via RefList.map_args, but positionally aware so each argument can be
// matched up with (and cast to) its callee's declared parameter type. Var-args
// tail arguments (beyond function_type's own, non-variadic parameter count)
// are generated uncast, same as type_check_arguments() already only type-checks
// up to that point.
void expression_generate_actual_arguments_casted (FILE *fp, RefList actual_arguments, FunctionType function_type, Bool is_first_arg) {
	int expected_length = function_type.parameters.size ();
	if (function_type.has_var_args) {
		expected_length -= 1;
	}
	int i;
	for (i = 0; i < actual_arguments.size (); i += 1) {
		if (!is_first_arg) {
			fprintf (fp, ", ");
		}
		is_first_arg = false;
		Expression arg_expr = (Expression) actual_arguments.get (i);
		if (i < expected_length) {
			Type target_type = (Type) function_type.parameters.get (i);
			expression_generate_casted (fp, arg_expr, target_type);
		} else {
			arg_expr.generate (fp);
		}
	}
}

// Same as expression_generate_actual_arguments_casted, but for constructor
// calls (NewExpression, SuperExpression's ctor branch), whose formal
// arguments are a RefList of ArgumentDeclaration rather than a FunctionType
// with its own .parameters/.has_var_args -- callers derive has_var_args
// themselves (e.g. ConstructorDeclaration.has_var_args()) since not every
// caller has a ConstructorDeclaration on hand (only the target's formal
// argument list).
void expression_generate_ctor_arguments_casted (FILE *fp, RefList actual_arguments, RefList formal_arguments, Bool has_var_args, Bool is_first_arg) {
	int expected_length = formal_arguments.length;
	if (has_var_args) {
		expected_length -= 1;
	}
	int i;
	for (i = 0; i < actual_arguments.size (); i += 1) {
		if (!is_first_arg) {
			fprintf (fp, ", ");
		}
		is_first_arg = false;
		Expression arg_expr = (Expression) actual_arguments.get (i);
		if (i < expected_length) {
			ArgumentDeclaration arg_decl = (ArgumentDeclaration) formal_arguments.get (i);
			expression_generate_casted (fp, arg_expr, arg_decl.type);
		} else {
			arg_expr.generate (fp);
		}
	}
}

class Expression : CompileObject {
	Type type;

	~Expression () {
		type?.release ();
	}

	void generate (FILE *fp) {
		generate_left (fp, true);
	}

	void set_scope (Scope scope);


	void generate_left (FILE *fp, Bool left);
}
