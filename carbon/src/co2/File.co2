include co2/String
include co2/List
include co2/Map
include co2/HashMap
include co2/Context
include co2/Declaration
include co2/CompileObjectVisitor
include co2/InterfaceDeclaration
include co2/ObjectType
include co2/ClassDeclaration
include co2/VariableDeclaration
include co2/FunctionDeclaration

File try_search_path(String file_name);

File current_file;

class File : CompileObject {
	String name, absolute_path;
	RefList file_dependencies, declarations;

	File (String name, String absolute_path) {
		self.name = (String) name.retain ();
		self.absolute_path = (String) absolute_path.retain ();
		declarations = new RefList (8, Declaration.class);
		declarations.retain ();
		file_dependencies = new RefList (8, File.class);
		file_dependencies.retain ();
	}

	~File () {
		name.release ();
		absolute_path.release ();
		declarations.release ();
		file_dependencies.release ();
	}

	void accept_all_files (CompileObjectVisitor visitor) {
		void accept_all_files_callback (File file) {
			file.accept_all_files (visitor);
		}

		file_dependencies.map (accept_all_files_callback);
		accept (visitor);
	}

	void accept (CompileObjectVisitor visitor) {
		current_context?.add (self);
		declarations.map_args (compileobject_accept, visitor);
		visitor.visit (self);
		current_context?.remove_last ();
	}

	void sort() {
		fixup_declaration_order (declarations);
	}

	void type_check () {
		file_dependencies.map (file_type_check);
		declarations.map (file_type_check);
	}

	void optimize () {
		declarations.map (file_optimize);
	}

	void generate (FILE *fp) {
		int file_definition_filter (Declaration member) {
			return member.include_file != null;
		}

		int file_declaration_filter (Declaration member) {
			return member.include_file == null;
		}

		List definitions = declarations.filter (file_definition_filter);
		List declarations =  declarations.filter (file_declaration_filter);

		void generate_callback (CompileObject object) {
			object.generate (fp);
		}

		definitions.map (generate_callback);
		declarations.map (generate_callback);

		delete definitions;
		delete declarations;
	}

	void generateDepend () {
		void generateDepend_callback (File object) {
			object.generateDepend ();
		}

		printf (" \\\n %s", absolute_path.data);
		file_dependencies.map (generateDepend_callback);
	}
}


// Only used in lex.l
Map file_hash_map = null;
Map get_hash_map() {
	if (!file_hash_map) {
		file_hash_map = new HashMap (127);
	}
	return file_hash_map;
}

void file_type_check (CompileObject object) {
	if (object is_of Declaration) {
		current_context = new Context();
		current_context.retain ();
		object.type_check ();
		current_context.release ();
		current_context = null;
	} else {
		object.type_check ();
	}
}

void file_optimize (CompileObject object) {
	
}

bool token_equals (Token myself, Token other) {
	return strcmp (myself.name.data, other.name.data) == 0;
}

void interface_depends_on (Token myself, va_list *app) {
	InterfaceDeclaration decl2 = (InterfaceDeclaration) va_arg (*app, void *);
	bool * depends = va_arg (*app, bool *);
	if (token_equals (myself, decl2.name)) {
		*depends = true;
	} else {
		if (global_scope.exists (myself)) {
			Declaration super_decl = global_scope.lookup (myself);
			if (super_decl is_of InterfaceDeclaration 
			    && interfacedeclaration_1_depends_on_2 ((InterfaceDeclaration) super_decl, decl2)) {
				*depends = true;
			}
		}
	}
}

bool interfacedeclaration_1_depends_on_2 (InterfaceDeclaration decl1, Declaration decl2) {
	bool depends = false;
	decl1.interfaces?.map_args (interface_depends_on, decl2, &depends);
	return depends;
}

bool classdeclaration_1_depends_on_2 (ClassDeclaration decl1, ClassDeclaration decl2) {
	if (decl1.superclass) {
		if (token_equals (decl1.superclass, decl2.name)) {
			return true;
		}
		if (global_scope.exists (decl1.superclass)) {
			Declaration super_decl = global_scope.lookup (decl1.superclass);
			if (super_decl is_of ClassDeclaration) {
				return classdeclaration_1_depends_on_2 ((ClassDeclaration) super_decl, decl2);
			}
		}
	}
	return false;
}

// Whether decl1's class implements interface decl2 directly (mixin),
// i.e. decl2's Interface_Attr chain must already be defined for decl1's
// own _Attr/Class_Attr macros to expand.
bool classdeclaration_implements_interface (ClassDeclaration decl1, InterfaceDeclaration decl2) {
	bool depends = false;

	void token_equals_callback (Token myself) {
		if (token_equals (myself, decl2.name)) {
			depends = true;
		}
	}

	decl1.interfaces?.map (token_equals_callback);
	return depends;
}

void classdeclaration_attribute_uses_type_callback (VariableDeclaration var_decl, va_list *app) {
	TypeDeclaration type_decl = (TypeDeclaration) va_arg (*app, void *);
	bool *found = va_arg (*app, bool *);
	if (var_decl.type && var_decl.type is_of ObjectType) {
		ObjectType type = (ObjectType) var_decl.type;
		if (!type.decl) {
			type.type_check ();
		}
		if (type.decl == type_decl) {
			*found = true;
		}
	}
}

// Whether decl1 declares an attribute (a field) whose type is decl2 --
// i.e. decl1's generated struct/macros can't be emitted before decl2 is.
// This is separate from the superclass/interface dependency chains above,
// since a plain-C typedef (e.g. "typedef Timeval = struct timeval;")
// used only as a field type never appears in those inheritance graphs.
bool classdeclaration_depends_on_type (ClassDeclaration decl1, TypeDeclaration decl2) {
	bool found = false;
	decl1.members.map_args (classdeclaration_attribute_uses_type_callback, decl2, &found);
	return found;
}

// Whether decl1 must be generated after decl2, for any of the reasons
// this file's codegen visitors actually rely on: same-file superclass,
// same-file mixin interface, same-file superinterface, or same-file
// field-type typedef. Declarations with no modeled relationship (plain
// functions/variables, raw C structs, or anything from a *different*
// file that's brought in via #include instead) simply return false --
// their relative order doesn't matter for correctness.
bool declaration_depends_on (Declaration decl1, Declaration decl2) {
	if (decl1 is_of ClassDeclaration) {
		ClassDeclaration class_decl1 = (ClassDeclaration) decl1;
		if (decl2 is_of ClassDeclaration &&
		    classdeclaration_1_depends_on_2 (class_decl1, (ClassDeclaration) decl2)) {
			return true;
		}
		if (decl2 is_of InterfaceDeclaration &&
		    classdeclaration_implements_interface (class_decl1, (InterfaceDeclaration) decl2)) {
			return true;
		}
		if (decl2 is_of TypeDeclaration &&
		    classdeclaration_depends_on_type (class_decl1, (TypeDeclaration) decl2)) {
			return true;
		}
	} else if (decl1 is_of InterfaceDeclaration) {
		if (decl2 is_of InterfaceDeclaration &&
		    interfacedeclaration_1_depends_on_2 ((InterfaceDeclaration) decl1, decl2)) {
			return true;
		}
	}
	return false;
}

// A file's top-level declarations must be generated in an order that
// respects same-file dependencies (a class after its superclass, a
// typedef before the class using it as a field type, etc). This used
// to be done with qsort() and a pairwise comparator, but qsort only
// ever calls the comparator on pairs its pivot selection happens to
// pick -- a real dependency between two declarations can go entirely
// unseen if every comparison involving either of them goes through an
// unrelated third declaration instead. No comparison-based sort fixes
// that, because the underlying relationship is a partial order (most
// declarations have no relationship to each other at all), not the
// total order a sort comparator assumes.
//
// So instead: for every declaration, scan strictly forward for any
// later declaration it depends on and relocate it to just before, in
// one left-to-right sweep. When a dependency is moved, `i` advances
// past it before continuing the same scan, so chains of dependencies
// (C depends on B depends on A) still end up fully in order.
void fixup_declaration_order (RefList declarations) {
	RefObject[] data = declarations.data;
	int n = declarations.length;
	int i;
	for (i = 0; i < n; i += 1) {
		Declaration decl = (Declaration) data[i];
		if (decl) {
			int j = i + 1;
			while (j < n) {
				Declaration other = (Declaration) data[j];
				if (other && declaration_depends_on (decl, other)) {
					RefObject moved = data[j];
					int k;
					for (k = j; k > i; k -= 1) {
						data[k] = data[k - 1];
					}
					data[i] = moved;
					i += 1;
				}
				j += 1;
			}
		}
	}
}
