include co2/Expression
include co2/RefList
include co2/TokenExpression
include co2/BinaryExpression
include co2/ConditionalBinaryExpression
include co2/ClassDeclaration

// A virtually-dispatched call (ordinary class-scope O_CALL, which is every
// plain method call in this object model -- there's no non-virtual variant)
// goes through a vtable slot whose C signature is fixed by whichever
// class/interface *first* declared the method name, per
// ClassDeclaration.find_base_function_declaration(). But the type-checker
// resolves function_expr's .type against the receiver's *static* type,
// which finds whatever override is nearest (e.g. RefList's own narrower
// `RefList filter(...)`, not List's `List filter(...)` that actually
// shapes the vtable slot). Casting *call arguments* against the base
// signature is safe (used in generate() below) -- argument *validation*
// (type_check_arguments) still uses the resolved/most-derived signature,
// since that's the real declared contract being called.
//
// Also used (see type_check() below) to override this call expression's own
// .type with the base-declared return type, so a caller-side
// "struct RefList* x = obj.filter()" cast is generated correctly against the
// vtable slot's actual (base) type instead of the override's narrower one.
//
// This previously caused spurious "incompatible types: Bool and Bool"
// errors during self-hosted rebuilds (tried and reverted twice, in two
// separate sessions, before being root-caused): find_base_function_declaration
// reaches into another declaration's AST directly, bypassing the normal
// type_check() traversal that would otherwise already have resolved that
// return type's ObjectType.decl (ObjectType lazily resolves .decl on first
// type_check() call, see ObjectType.type_check()). Type.is_compatible()'s
// get_declared_type() silently returns an unresolved ObjectType wrapper as-is
// (rather than resolving it), so comparing it against an already-resolved
// ObjectType for the exact same typedef (e.g. "Bool") failed the class check
// even though both sides were, in fact, the same declaration. Fixed below by
// forcing type_check() on the base-resolved type before returning it.
FunctionType functioncallexpression_resolve_vtable_type (Expression function_expr, FunctionType resolved_type) {
	ObjectTypeDeclaration receiver_decl = null;
	Token method_name = null;
	if (function_expr is_of TokenExpression) {
		TokenExpression token_expr = (TokenExpression) function_expr;
		if (token_expr.decl && token_expr.decl is_of FunctionDeclaration) {
			FunctionDeclaration fun_decl = (FunctionDeclaration) token_expr.decl;
			if (fun_decl.scope && fun_decl.scope.get_type () == class_scope_type) {
				receiver_decl = (ObjectTypeDeclaration) current_context?.find (ClassDeclaration.class);
				method_name = token_expr.token;
			}
		}
	} else if (function_expr is_of BinaryExpression) {
		BinaryExpression bin_expr = (BinaryExpression) function_expr;
		if (bin_expr.operator.type == '.' && bin_expr.operand[0].type is_of ObjectType) {
			receiver_decl = ((ObjectType) bin_expr.operand[0].type).decl;
			method_name = bin_expr.operand[1].get_token ();
		}
	}
	if (receiver_decl && receiver_decl is_of ClassDeclaration && method_name) {
		ClassDeclaration class_decl = (ClassDeclaration) receiver_decl;
		FunctionDeclaration base_decl = class_decl.find_base_function_declaration (method_name);
		if (base_decl && base_decl.type is_of FunctionType) {
			base_decl.type.type_check ();
			return (FunctionType) base_decl.type;
		}
	}
	return resolved_type;
}

class FunctionCallExpression : Expression {
	Expression function;
	RefList actual_arguments;

	FunctionCallExpression (Expression function, RefList args) {
		super ();
		self.function = (Expression) function.retain ();
		actual_arguments = (RefList) args.retain ();
	}

	~FunctionCallExpression () {
		function.release ();
		actual_arguments.release ();
	}

	void accept (CompileObjectVisitor visitor) {
		function.accept (visitor);
		actual_arguments.map_args (compileobject_accept, visitor);
		visitor.visit (self);
	}

	void generate (FILE *fp) {
		FunctionType resolved_function_type = functioncallexpression_resolve_vtable_type (self.function, (FunctionType) self.function.type);
		if (function is_of TokenExpression) {
			TokenExpression function = (TokenExpression) self.function;
			if (function.decl && function.decl is_of FunctionDeclaration) {
				FunctionDeclaration fun_decl = (FunctionDeclaration) function.decl;
				ScopeType scope_type = fun_decl.scope.get_type ();
				if (scope_type == class_scope_type) {
					fprintf (fp, "O_CALL ");
					fprintf (fp, "(");
					fprintf (fp, "self, ");
					function.token.generate (fp);
					expression_generate_actual_arguments_casted (fp, actual_arguments, resolved_function_type, false);
					fprintf (fp, ")");
					return;
				} else if (scope_type == interface_scope_type) {
					fprintf (fp, "O_CALL_IF ");
					fprintf (fp, "(");
					if (!fun_decl.implemented_methods || fun_decl.implemented_methods.size () == 0) {
						InterfaceDeclaration interface_decl = (InterfaceDeclaration) current_context.find (InterfaceDeclaration.class);
						interface_decl.name.generate (fp);
					} else if (fun_decl.implemented_methods.size () == 1) {
						InterfaceMethodDefinition imd = (InterfaceMethodDefinition) fun_decl.implemented_methods.get (0);
						imd.interface_decl.name.generate (fp);
					} else {
						warning (function.token, "ambiguous method name: %s\n", function.token.name.data);
						InterfaceMethodDefinition imd = (InterfaceMethodDefinition) fun_decl.implemented_methods.get (0);
						imd.interface_decl.name.generate (fp);
					}
					fprintf (fp, ", self, ");
					function.token.generate (fp);
					expression_generate_actual_arguments_casted (fp, actual_arguments, resolved_function_type, false);
					fprintf (fp, ")");
					return;
				} else {
					function.token.generate (fp);
				}
			} else {
				function.token.generate (fp);
			}
		} else if (function is_of BinaryExpression) {
			BinaryExpression function = (BinaryExpression) function;
			ObjectType function_type = (ObjectType) function.operand[0].type;
			if (function_type.decl is_of ClassDeclaration) {
				if (self.function is_of ConditionalBinaryExpression) {
					fprintf (fp, "O_BRANCH_CALL ");
				} else {
					fprintf (fp, "O_CALL ");
				}
				fprintf (fp, "(");
				function.operand[0].generate (fp);
				fprintf (fp, ", ");
				function.operand[1].generate_left (fp, false);
				expression_generate_actual_arguments_casted (fp, actual_arguments, resolved_function_type, false);
				fprintf (fp, ")");
				return;
			} else if (function_type.decl is_of InterfaceDeclaration) {
				if (self.function is_of ConditionalBinaryExpression) {
					fprintf (fp, "O_BRANCH_CALL_IF ");
				} else {
					fprintf (fp, "O_CALL_IF ");
				}
				fprintf (fp, "(");
				function_type.decl.name.generate (fp);
				fprintf (fp, ", ");
				function.operand[0].generate (fp);
				fprintf (fp, ", ");
				function.operand[1].generate_left (fp, false);
				expression_generate_actual_arguments_casted (fp, actual_arguments, resolved_function_type, false);
				fprintf (fp, ")");
				return;
			}
		} else {
			function.generate (fp);
		}
		fprintf (fp, " (");
		Bool is_first_arg = true;
		if (function is_of BinaryExpression) {
			BinaryExpression function = (BinaryExpression) self.function;
			if (function.operator.type == '.') {
				function.operand[0].generate (fp);
				is_first_arg = false;
			}
		}
		expression_generate_actual_arguments_casted (fp, actual_arguments, resolved_function_type, is_first_arg);
		fprintf (fp, ")");
	}

	Token get_token () {
		return function.get_token ();
	}

	void argument_error (FunctionType function_type) {
		Token token = get_token ();
		// TODO determine the name of the function here
		error (token, "'%s' needs %d arguments, but got %d.\n", "function", function_type.parameters.size (), actual_arguments.size ());
	}

	void type_check_arguments (FunctionType function_type) {
		int expected_length = function_type.parameters.size ();
		if (function_type.has_var_args) {
			expected_length -= 1;
			if (actual_arguments.size () < expected_length) {
				argument_error (function_type);
				return;
			}
		} else {
			if (actual_arguments.size () != expected_length) {
				argument_error (function_type);
			}
		}
		int i;
		for (i = 0; i < actual_arguments.size (); i += 1) {
			if (i < expected_length) {
				Type arg_type = (Type) function_type.parameters.get (i);
				Expression arg_expr = (Expression) actual_arguments.get (i);

				arg_expr.type_check ();
				arg_type.type_check ();
				arg_type.assert_compatible (arg_expr.type);
			} else {
				Expression arg_expr = (Expression) actual_arguments.get (i);

				arg_expr.type_check ();
			}
		}				
	}

	void type_check () {
		function.type_check ();
		if (!function.type) {
			return;
		}
		if (!function.type is_of FunctionType) {
			Token token = function.get_token ();
			error (token, "'%s' is not a function\n", token.name.data);
			return;
		}
		FunctionType function_type = (FunctionType) function.type;
		FunctionType resolved_function_type = functioncallexpression_resolve_vtable_type (function, function_type);
		type = (Type) resolved_function_type.return_type.retain ();
		type_check_arguments (function_type);
	}
}
